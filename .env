# Read by the docker compose CLI, never by farmd.
#
# THIS FILE IS IN GIT. Nothing secret goes here: no DATABASE_URL with a
# password, no FARM_API_TOKENS, no FARM_NODE_TOKEN. Those belong in the
# shell that runs compose, or in the Helm chart's Secret. Compose reads
# the environment first, so exporting a variable overrides anything set
# here without editing a tracked file.
#
# The demo service sits behind the "demo" profile so that
# `docker compose --profile farm up -d` cannot start simulated hardware against
# a real farm's database. This default keeps the laptop command a bare
# `docker compose up -d`. A --profile flag, or COMPOSE_PROFILES in the shell,
# REPLACES this value rather than adding to it — which is what makes the two
# commands exclusive.
COMPOSE_PROFILES=demo
